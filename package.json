{
  "name": "dsh-weight-panel",
  "version": "1.0.0",
  "description": "DSH sidebar panel for logging daily weight, waist, steps and training minutes, with weekly trend, distance to goal and a projected goal date.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cvjdsgkgrn-ui/dsh-weight-panel"
  },
  "bugs": {
    "url": "https://github.com/cvjdsgkgrn-ui/dsh-weight-panel/issues"
  },
  "homepage": "https://github.com/cvjdsgkgrn-ui/dsh-weight-panel#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "weight",
    "health",
    "tracking"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README_CN.md"
  ],
  "scripts": {
    "check": "node check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "manifestVersion": 1
  }
}
